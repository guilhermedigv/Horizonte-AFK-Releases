package main

// applyV16Patch layers the 1.6 desktop experience on top of the already
// validated 1.5 feature patch. Network/dialog handling remains in the same
// embedded runtime; multi-server sessions are isolated but headless and are
// controlled from the single visible main window through local JSON IPC.
func applyV16Patch(s string) string {
	s = replaceRequired(s, "$appVersion = '1.5.0'", "$appVersion = '1.6.0'")

	// Desktop integration used by the visible launcher only. Child sessions skip
	// this block entirely so they never create taskbar/tray entries.
	s = replaceRequired(s, `Add-Type -AssemblyName System.Security`, `Add-Type -AssemblyName System.Security
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type @"
using System;
using System.Runtime.InteropServices;
public static class HZDesktop {
    [DllImport("shell32.dll", CharSet=CharSet.Unicode)]
    public static extern int SetCurrentProcessExplicitAppUserModelID(string appId);

    [DllImport("user32.dll", EntryPoint="SendMessageW")]
    public static extern IntPtr SendMessage(IntPtr hWnd, uint msg, IntPtr wParam, IntPtr lParam);

    [DllImport("user32.dll")]
    public static extern bool DestroyIcon(IntPtr hIcon);

    public const uint WM_SETICON = 0x0080;
    public const int ICON_SMALL = 0;
    public const int ICON_BIG = 1;
}
"@`)

	// Keep the multi-session controls in the same window. Five fixed rows avoid
	// creating any extra WPF window and make state updates deterministic.
	s = replaceRequired(s, `                            <Button x:Name="MultiServerButton" Content="CONECTAR EM VÁRIOS SERVIDORES"
                                    Style="{StaticResource FlatButton}" Margin="0,0,0,9"
                                    BorderBrush="#1A6B93" Foreground="#8DDFFF"/>`, `                            <Button x:Name="MultiServerButton" Content="CONECTAR EM VÁRIOS SERVIDORES"
                                    Style="{StaticResource FlatButton}" Margin="0,0,0,9"
                                    BorderBrush="#1A6B93" Foreground="#8DDFFF"/>

                            <Border x:Name="MultiSessionsCard" Visibility="Collapsed"
                                    Background="#091B2A" BorderBrush="#195274" BorderThickness="1"
                                    CornerRadius="11" Padding="11" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="1,0,1,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="SESSÕES ATIVAS" Foreground="#DFF5FF" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="Todos os servidores ficam neste único painel" Foreground="#6F8BA6" FontSize="8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0B3850" CornerRadius="8" Padding="7,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="MultiSessionSummary" Text="0 ativas" Foreground="#5DDCFF" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <Border x:Name="MultiRow1" Visibility="Collapsed" Background="#0B1624" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="#1" Foreground="#41D2FF" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MultiStatus1" Grid.Column="1" Text="Iniciando..." Foreground="#D9E7F5" FontSize="9" VerticalAlignment="Center"/>